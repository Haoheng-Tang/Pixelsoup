{
  // src/core must stay free of DOM, React, Node and Electron. No "DOM" lib and no
  // ambient @types here, so any accidental use of browser globals fails to compile.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/core/**/*.ts"]
}
